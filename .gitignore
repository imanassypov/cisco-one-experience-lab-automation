# Ansible
*.retry
.vault
.vault_pass
**/secrets.yml
!**/secrets.yml.example
**/evidence/
# Pod-local lab values. Every student must set lab_pod_id and lab_ap_macs, so
# tracking this file made the working tree permanently dirty and blocked
# ansible.builtin.git from ever updating the checkout again. Seed it from
# lab.yml.example, which is tracked.
**/group_vars/all/lab.yml
!**/group_vars/all/lab.yml.example

# Splunk assurance build output. The .spl is rebuilt from splunk-app/ on every
# deploy, and the rendered collector config carries a live HEC token. The patched
# receiver source bundle is the one tarball that must stay tracked - the custom
# otelcol-yangfix binary cannot be rebuilt without it.
**/packaging/dist/
*.spl
**/otel-collector/agent_config.yaml
!**/otel-collector/receiver_yang_*.tar.gz

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
.idea/
.vscode/

# Ansible local cache
.ansible/
