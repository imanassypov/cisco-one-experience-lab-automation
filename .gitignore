# Ansible
*.retry
.vault
.vault_pass
**/secrets.yml
!**/secrets.yml.example
**/evidence/
# Pod-local lab values. Every student must set lab_pod_id and lab_ap_macs, so
# tracking this file made the working tree permanently dirty and blocked
# ansible.builtin.git from ever updating the checkout again. Seed it from
# lab.yml.example, which is tracked.
**/group_vars/all/lab.yml
!**/group_vars/all/lab.yml.example

# Splunk assurance build output. The .spl is rebuilt from splunk-app/ on every
# deploy. The collector config is only ever rendered onto the Splunk host, where
# it carries a live HEC token, so a copy here would be a leak.
**/packaging/dist/
*.spl
**/otel-collector/agent_config.yaml

# IOS-XE software images staged for SWIM (stage 11). Multi-GB binaries that must
# never reach git — GitHub hard-rejects anything over 100 MB. The bootstrap
# copies whatever is in here onto the script server's HTTP root, from where
# Catalyst Center pulls it. Drop the .bin files in by hand.
iosxe_images/*
!iosxe_images/.gitkeep
!iosxe_images/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
.idea/
.vscode/

# Ansible local cache
.ansible/
