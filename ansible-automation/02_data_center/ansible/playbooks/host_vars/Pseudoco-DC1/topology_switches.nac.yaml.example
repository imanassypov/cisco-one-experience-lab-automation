---
# Template for the fabric's switches and their server port-channels. Stage 00 copies it
# to topology_switches.nac.yaml and fills in each serial number (REPLACE_ME - leave it).
# Switch names must match inventory/group_vars/all/dc_switches.yml exactly.
vxlan:
  topology:
    switches:
      - name: DC-Leaf1
        serial_number: REPLACE_ME
        role: leaf
        management:
          management_ipv4_address: 198.18.128.101
        # Each port-channel below is one vPC to a server, built on both leaves.
        # Keep descriptions plain ASCII (hyphens, not dashes); they become switch config.
        interfaces:
          - name: Port-channel3
            mode: access
            vpc_id: 3
            description: "MAIN server - vPC3"
            members:
              - Ethernet1/3
          - name: Port-channel4
            mode: access
            vpc_id: 4
            description: "PROD server - vPC4"
            members:
              - Ethernet1/4
          - name: Port-channel5
            mode: access
            vpc_id: 5
            description: "IOT server - vPC5"
            members:
              - Ethernet1/5

      - name: DC-Leaf2
        serial_number: REPLACE_ME
        role: leaf
        management:
          management_ipv4_address: 198.18.128.102
        interfaces:
          - name: Port-channel3
            mode: access
            vpc_id: 3
            description: "MAIN server - vPC3"
            members:
              - Ethernet1/3
          - name: Port-channel4
            mode: access
            vpc_id: 4
            description: "PROD server - vPC4"
            members:
              - Ethernet1/4
          - name: Port-channel5
            mode: access
            vpc_id: 5
            description: "IOT server - vPC5"
            members:
              - Ethernet1/5

      - name: DC-SPINE-1
        serial_number: REPLACE_ME
        role: spine
        management:
          management_ipv4_address: 198.18.128.11
        interfaces: []

      - name: DC-SPINE-2
        serial_number: REPLACE_ME
        role: spine
        management:
          management_ipv4_address: 198.18.128.12
        interfaces: []

      - name: DC-Service-Leaf
        serial_number: REPLACE_ME
        role: border
        management:
          management_ipv4_address: 198.18.128.13
        interfaces: []
