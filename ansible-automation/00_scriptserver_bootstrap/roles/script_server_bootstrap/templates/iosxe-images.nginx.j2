# {{ ansible_managed }}
# IOS-XE software image server for Catalyst Center SWIM (campus stage 09).
# Its own port and server block so re-running cannot disturb the default site.
server {
    listen {{ script_server_image_http_port }};
    listen [::]:{{ script_server_image_http_port }};

    server_name _;
    root {{ script_server_image_root }};

    # Directory listing makes it easy to confirm from a browser what Catalyst
    # Center can see.
    autoindex on;
    autoindex_exact_size off;

    # Catalyst Center streams the whole .bin in one request; the default 60s
    # would cut a multi-hundred-MB transfer short on a slow pod.
    sendfile on;
    send_timeout 900s;
    keepalive_timeout 900s;

    location / {
        try_files $uri $uri/ =404;
    }
}
