{#- Segment inventory lookup, generated by the assurance_lookups role.        -#}
{#- Keyed on the access VLAN: the dashboards look up `vlan AS access_vlan`.   -#}
{#- L2VNI is derived the same way FABRIC-NVE.j2 derives it (offset + vlan);   -#}
{#- L3VNI is explicit on each DEFN_VRF entry.                                 -#}
{%- set l2_offset = _assurance_intent.l2vni_offset | int -%}
{%- set leaves = _assurance_intent.node_roles.get('CLIENT', []) | join(' ') -%}
{%- set l3_by_vrf = {} -%}
{%- for v in _assurance_intent.vrfs %}{% set _ = l3_by_vrf.update({v.name: v.l3_vni}) %}{% endfor -%}
vlan,l2vni,l3vni,vrf,segment_name,overlay_leaves,access_leaves
{% for tenant in _assurance_intent.overlay %}
{% for vlan_id in tenant.vlan_ids %}
{{ vlan_id }},{{ l2_offset + (vlan_id | int) }},{{ l3_by_vrf.get(tenant.vrf, '') }},{{ tenant.vrf }},{{ tenant.vlans[vlan_id].name | default(tenant.vrf ~ '-' ~ vlan_id) }},{{ leaves }},{{ leaves }}
{% endfor %}
{% endfor %}
