{#- Device inventory lookup, generated by the assurance_lookups role. -#}
{#- `hostname` MUST equal the collector's cisco.node_id dimension, which IOS-XE -#}
{#- takes from the bare `hostname` command - the domain from `ip domain name`   -#}
{#- is NOT appended. Verified 2026-09-19: the fabric emits `Site_105-Leaf1`,    -#}
{#- not `Site_105-Leaf1.corp.pseudoco.com`, and there is no telemetry config    -#}
{#- option to change it. Emitting the FQDN here silently broke every lookup.    -#}
{#- The intent keys ARE FQDNs (they match Catalyst Center inventory), so they   -#}
{#- are kept in `source` for provenance and shortened for the join key.         -#}
{#- Catalyst Center manages these nodes by Loopback0, so ip_address == loopback. -#}
{%- set roles = _assurance_intent.node_roles -%}
source,hostname,ip_address,loopback,site,role,description
{% for host, loopback in (_assurance_intent.loop_underlay | dictsort) %}
{#- Collapse the role sets this lab actually uses into one dashboard role.    -#}
{#- Site 105 folds spine, route-reflector and border onto a single node, so a -#}
{#- combined node gets one role value rather than duplicate lookup rows: the  -#}
{#- lookup is keyed on hostname and would only ever return the first match.   -#}
{%- set is_spine = host in roles.get('SPINE', []) -%}
{%- set is_border = host in roles.get('BORDER', []) -%}
{%- set is_client = host in roles.get('CLIENT', []) -%}
{%- if is_spine and is_border %}{% set role = 'border-spine' %}{% set desc = 'Combined spine / route-reflector / border' %}
{%- elif is_spine %}{% set role = 'spine' %}{% set desc = 'Fabric spine' %}
{%- elif is_border %}{% set role = 'border' %}{% set desc = 'Fabric border' %}
{%- elif is_client %}{% set role = 'leaf' %}{% set desc = 'Campus EVPN leaf (CLIENT role)' %}
{%- else %}{% set role = 'unassigned' %}{% set desc = 'No DEFN-ROLES membership' %}
{%- endif %}
{{ host }},{{ host | regex_replace('\..*$', '') }},{{ loopback }},{{ loopback }},{{ assurance_site }},{{ role }},{{ desc }}
{% endfor %}
