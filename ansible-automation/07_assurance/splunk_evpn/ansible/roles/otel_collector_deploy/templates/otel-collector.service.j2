{{ ansible_managed | comment }}
# Written by the otel_collector_deploy role when the host has no Splunk
# OpenTelemetry collector package to override. otelcol-yangfix is a static Go
# binary with no package dependencies, so a plain unit is all it needs.
[Unit]
Description=OpenTelemetry Collector - campus EVPN assurance
Documentation=https://github.com/imanassypov/cisco-one-experience-lab-automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ otel_service_user }}
Group={{ otel_service_user }}
ExecStart={{ otel_binary_in_use }} --config={{ otel_config_path }}
Restart=on-failure
RestartSec=5s
# The fabric holds long-lived gRPC streams that do not drain on SIGTERM, so a
# stop waits this long before systemd kills the process.
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
