{## CATC: productFamily=Switches and Hubs, softwareType=IOS-XE, productSeries=Cisco Catalyst 9300 Series Switches ##}
{# FABRIC-TELEMETRY-SPLUNK.j2 - IOS-XE MDT Telemetry subscriptions for Splunk/OpenTelemetry collection #}
{% include "{{ TEMPLATE_PROJECT_NAME }}/DEFN-ROLES.j2" %}
{% include "{{ TEMPLATE_PROJECT_NAME }}/DEFN-TELEMETRY-SPLUNK.j2" %}
{% set DEVICE_HOSTNAME = __device.hostname | default('', true) %}
{# Telemetry target roles come from Settings/settings.json telemetry.splunk.roles.  #}
{# template_sync expands TELEMETRY_ROLE_GUARD into LITERAL-key lookups              #}
{# (DEFN_NODE_ROLES['ROLE'] or ...) - the only reliable pattern in Catalyst Center's #}
{# included-scope Jinja engine. A variable-key iteration (for role in               #}
{# DEFN_TELEMETRY_SPLUNK_ROLES -> DEFN_NODE_ROLES[role]) silently returned empty, so #}
{# this section never rendered on CLIENT-only nodes (leaves). Hence the expansion    #}
{# happens at sync time, not render time.                                            #}
{% if DEFN_TELEMETRY_SPLUNK_RECEIVER_IP and ({{ TELEMETRY_ROLE_GUARD }}) %}
! =============================================================================
! IOS-XE MDT Telemetry Subscriptions - Campus BGP EVPN VXLAN Fabric
! =============================================================================
! Collector : {{ DEFN_TELEMETRY_SPLUNK_RECEIVER_IP }} (OTel collector), port {{ DEFN_TELEMETRY_SPLUNK_RECEIVER_PORT }} (yang_grpc)
! Protocol  : gRPC dial-out (receiver ip address format)
! Encoding  : encode-kvgpb
! Source VRF: Mgmt-vrf (all devices)
! IOS-XE    : Validated on 17.18.02 (Cisco CAT9k)
! =============================================================================
!
{% for section in DEFN_TELEMETRY_SPLUNK %}
! -----------------------------------------------------------------------------
! Sub {{ section['subscriptions'][0]['id'] }}{% if section['subscriptions'] | length > 1 %}-{{ section['subscriptions'][-1]['id'] }}{% endif %} - {{ section['section'] }}
! XPath : {{ section['xpath'] }}
! -----------------------------------------------------------------------------
{% for subscription in section['subscriptions'] %}
telemetry ietf subscription {{ subscription['id'] }}
 encoding encode-kvgpb
 filter xpath {{ section['xpath'] }}
 stream yang-push
{% if subscription['policy'] == 'periodic' %}
 update-policy periodic {{ subscription['period'] }}
{% else %}
 update-policy {{ subscription['policy'] }}
{% endif %}
 source-vrf Mgmt-vrf
 receiver ip address {{ DEFN_TELEMETRY_SPLUNK_RECEIVER_IP }} {{ DEFN_TELEMETRY_SPLUNK_RECEIVER_PORT }} protocol grpc-tcp
!
{% endfor %}
{% endfor %}
{# EVPN route statistics were emitted here. REMOVED 2026-09-19.                   #}
{#                                                                                #}
{# Two separate faults, both confirmed on the box:                                #}
{#  1. The template emitted `telemetry enable statistics` as ONE line. Cisco's    #}
{#     EVPN Route Statistics doc (see 07_assurance Model Maps) specifies two      #}
{#     nested commands: `telemetry enable` then `statistics`.                     #}
{#  2. Neither form works on this platform. On C9300 / IOS-XE 26.01.02 the        #}
{#     parser rejects the keyword outright:                                       #}
{#       Site_105-Leaf1(config-evpn)#telemetry ?                                  #}
{#       % Unrecognized command                                                   #}
{#     and `show running-config all | include telemetry enable` returns nothing.  #}
{#     Also invalid on 17.12.01, so this is a platform gap, not a release gate.   #}
{#                                                                                #}
{# Moving the line out of FABRIC-NVE.j2 only relocated the failure - CatC still   #}
{# rejected it here with NCTP10214. Subscription 40113                            #}
{# (/evpn-oper-data/evpn-stats) was disabled in DEFN-TELEMETRY-SPLUNK.j2 on the   #}
{# same day: the device rejected its XPath too ("Invalid XPath filter"), so it    #}
{# was the single Invalid entry in `show telemetry ietf subscription summary`.    #}
{#                                                                                #}
{# TODO (IOS-XE 26.2): restore this enable block AND sub 40113 TOGETHER when the  #}
{# official 26.2 release ships - neither is useful alone. Probe first with        #}
{# `telemetry ?` under `l2vpn evpn` (read-only). Restore as TWO nested commands,  #}
{# not the single line this template used to emit:                                #}
{#   l2vpn evpn                                                                   #}
{#    telemetry enable                                                            #}
{#    statistics                                                                  #}
! =============================================================================
! Verification commands
! =============================================================================
! show telemetry ietf subscription all
! show telemetry ietf subscription 40114 detail
! show telemetry ietf subscription 40119 detail
! show telemetry connection all
! =============================================================================
!
{% endif %}