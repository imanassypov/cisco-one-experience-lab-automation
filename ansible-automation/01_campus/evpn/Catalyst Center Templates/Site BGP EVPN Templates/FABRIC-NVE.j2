{## CATC: productFamily=Switches and Hubs, softwareType=IOS-XE, productSeries=Cisco Catalyst 9300 Series Switches ##}
{# FABRIC-NVE.j2 - Standalone NVE/VLAN L3VNI Template #}
{# Generates NVE interface, L3VNI VLANs and SVIs for the current device #}
{% include "{{ TEMPLATE_PROJECT_NAME }}/DEFN-VRF.j2" %}
{% include "{{ TEMPLATE_PROJECT_NAME }}/FUNC-VRF-LOOKUP.j2" %}
{% include "{{ TEMPLATE_PROJECT_NAME }}/DEFN-ROLES.j2" %}
{% include "{{ TEMPLATE_PROJECT_NAME }}/DEFN-LOOPBACKS.j2" %}
{% include "{{ TEMPLATE_PROJECT_NAME }}/DEFN-VNIOFFSETS.j2" %}
{% include "{{ TEMPLATE_PROJECT_NAME }}/DEFN-TELEMETRY-SPLUNK.j2" %}
{# Dereference Catalyst Center magic variable #}
{% set DEVICE_HOSTNAME = __device.hostname | default('', true) %}
{# Resolve the VRF objects for this device #}
{% set vrf_objs = [] %}
{{ vrf_definition(DEFN_VRF, DEFN_VRF_TO_NODE, DEVICE_HOSTNAME) }}
{# Dummy sets for CatC's static UDV scanner. A bare {{ l3_vni }} is treated as
   a required input because {% set %} inside {% for %} is ignored, and
   default((L3VNIOFFSET|string) + vrf.id) does not parse as a declaration.
   Values come from DEFN-VRF via vrf['l3_vlan'] / vrf['l3_vni']. #}
{% set vrf = {'name': '', 'id': '', 'mdt_default': '', 'mdt_data': '', 'l3_vlan': '', 'l3_vni': ''} %}
{% set l3_vlan = '' %}
{% set l3_vni = '' %}
{# --- VLAN SECTION --- #}
! @start-ignore-compliance {#transparent mode#}
{% for vrf in vrf_objs %}
vlan {{ vrf['l3_vlan'] }}
 name L3-VRF-CORE-VLAN-{{ vrf['id'] }}
!
{% endfor %}
! @end-ignore-compliance
{# --- VLAN CONFIGURATION SECTION --- #}
{% for vrf in vrf_objs %}
vlan configuration {{ vrf['l3_vlan'] }}
 member vni {{ vrf['l3_vni'] }}
!
{% endfor %}
{# --- INTERFACE VLAN SECTION --- #}
{% for vrf in vrf_objs %}
interface Vlan{{ vrf['l3_vlan'] }}
 vrf forwarding {{ vrf['name'] }}
 ip unnumbered {{ DEFN_LOOP_NAME['UNDERLAY'] }}
 no autostate
!
{% endfor %}
{# --- INTERFACE NVE1 SECTION --- #}
interface nve1
 no ip address
 source-interface {{ DEFN_LOOP_NAME['UNDERLAY'] }}
 host-reachability protocol bgp
{% if DEVICE_HOSTNAME in DEFN_NODE_ROLES['CLIENT'] and not DEVICE_HOSTNAME in DEFN_NODE_ROLES['BORDER'] %}
 group-based-policy
{% endif %}
{% for vrf in vrf_objs %}
 member vni {{ vrf['l3_vni'] }} vrf {{ vrf['name'] }}
{% endfor %}
{# --- GLOBAL L2VPN EVPN SECTION (LEAF only, not SPINE or BORDER) --- #}
{% if DEVICE_HOSTNAME in DEFN_NODE_ROLES['CLIENT'] and not DEVICE_HOSTNAME in DEFN_NODE_ROLES['BORDER'] %}
l2vpn evpn
 replication-type static
 router-id {{ DEFN_LOOP_NAME['UNDERLAY'] }}
{% if DEFN_TELEMETRY_SPLUNK_RECEIVER_IP %}
 telemetry enable statistics
{% endif %}
!
{% endif %}
