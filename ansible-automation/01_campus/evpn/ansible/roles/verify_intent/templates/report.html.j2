{#- Formal verification report. Monochrome, print-friendly, no external assets, -#}
{#- because it is read on the script server or copied to a laptop offline.      -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Intent Verification Report — Stage 10</title>
<style>
  :root { --ink:#1a1a1a; --muted:#5f6b76; --rule:#d5d9dd; --rule-strong:#9aa3ac; --shade:#f4f5f6; }
  * { box-sizing:border-box; }
  html { -webkit-text-size-adjust:100%; }
  body {
    margin:0; background:#fff; color:var(--ink);
    font:15px/1.6 "Segoe UI", Helvetica, Arial, sans-serif;
    font-variant-numeric:tabular-nums;
  }
  .page { max-width:960px; margin:0 auto; padding:56px 48px 72px; }
  a { color:inherit; text-decoration:none; border-bottom:1px solid var(--rule-strong); }
  a:hover { border-bottom-color:var(--ink); }

  .doc-title { font-size:26px; font-weight:600; letter-spacing:-.2px; margin:0; }
  .doc-sub { color:var(--muted); font-size:14px; margin:6px 0 0; }
  .rule { border:0; border-top:2px solid var(--ink); margin:20px 0 0; }

  h2 { font-size:15px; font-weight:600; letter-spacing:.08em; text-transform:uppercase;
       margin:44px 0 14px; padding-bottom:7px; border-bottom:1px solid var(--rule-strong); }
  h3 { font-size:15px; font-weight:600; margin:30px 0 10px; }
  p { margin:0 0 12px; }
  .muted { color:var(--muted); }
  .small { font-size:13px; }

  table { width:100%; border-collapse:collapse; margin:0 0 16px; font-size:14px; }
  caption { text-align:left; color:var(--muted); font-size:13px; padding-bottom:6px; }
  th, td { text-align:left; padding:7px 12px 7px 0; border-bottom:1px solid var(--rule);
           vertical-align:top; }
  thead th { border-bottom:1px solid var(--rule-strong); font-weight:600; font-size:12px;
             letter-spacing:.06em; text-transform:uppercase; color:var(--muted); }
  tbody tr:last-child td { border-bottom:1px solid var(--rule-strong); }
  td.status { white-space:nowrap; width:1%; padding-right:24px; }
  .exception td { background:var(--shade); }
  .exception td.status { font-weight:600; }

  code, .mono { font-family:ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size:13px; }
  code { background:none; padding:0; }

  dl.meta { display:grid; grid-template-columns:200px 1fr; gap:0; margin:0;
            border-top:1px solid var(--rule); font-size:14px; }
  dl.meta dt { padding:7px 0; color:var(--muted); border-bottom:1px solid var(--rule); }
  dl.meta dd { padding:7px 0; margin:0; border-bottom:1px solid var(--rule); }

  ol.toc { margin:0; padding-left:20px; font-size:14px; }
  ol.toc li { margin:4px 0; }
  ol.toc ol { padding-left:20px; margin:4px 0; }

  .statement { border-left:3px solid var(--ink); padding:2px 0 2px 16px; margin:0 0 18px;
               font-size:15px; }
  .backlink { font-size:12px; color:var(--muted); font-weight:400; letter-spacing:0;
              text-transform:none; margin-left:10px; }
  .backlink a { border-bottom:none; }
  footer { margin-top:48px; padding-top:14px; border-top:1px solid var(--rule);
           color:var(--muted); font-size:12px; }

  @media print {
    .page { padding:0; max-width:none; }
    a { border-bottom:none; }
    h2 { page-break-after:avoid; }
    table, tr { page-break-inside:avoid; }
    .toc-section { page-break-after:always; }
  }
</style>
</head>
<body>
<div class="page" id="top">

<p class="doc-title">Intent Verification Report</p>
<p class="doc-sub">Campus BGP EVPN fabric — pipeline stage 10</p>
<hr class="rule">

<h2>Document control</h2>
<dl class="meta">
  <dt>Report generated</dt><dd>{{ '%Y-%m-%d %H:%M:%S' | strftime }} UTC</dd>
  <dt>Produced by</dt><dd><code>playbooks/10_verify_intent.yml</code></dd>
  <dt>Intent sources</dt>
  <dd><code>settings.json</code> and <code>{{ verify_defn_prefix }}*.j2</code> as held in Catalyst Center Template Programmer</dd>
  <dt>Evidence collection</dt><dd>Catalyst Center Command Runner; responses parsed with Genie</dd>
  <dt>Devices in scope</dt><dd>{{ _verify_devices | length }}</dd>
  <dt>Controls evaluated</dt><dd>{{ _verify_results | length }}</dd>
  <dt>Assessment</dt>
  <dd>{% if _verify_counts.fail | int > 0 %}Non-conformant — {{ _verify_counts.fail }} exception(s){% else %}Conformant — no exceptions{% endif %}</dd>
</dl>

<h2>Contents</h2>
<div class="toc-section">
<ol class="toc">
  <li><a href="#s1">Conclusion</a></li>
  <li><a href="#s2">Scope</a></li>
  <li><a href="#s3">Basis of verification</a></li>
  <li><a href="#s4">Findings</a>
    <ol>
    {% for dev in _verify_devices %}
      <li><a href="#dev-{{ loop.index }}">{{ dev.hostname }}</a></li>
    {% endfor %}
    </ol>
  </li>
  <li><a href="#s5">Control index</a></li>
  {% if _verify_blacklisted | length > 0 %}
  <li><a href="#s6">Limitations of scope</a></li>
  {% endif %}
</ol>
</div>

<h2 id="s1">1. Conclusion</h2>
{% if _verify_counts.fail | int > 0 %}
<p class="statement">
  The deployed fabric does <strong>not</strong> conform to the declared intent.
  {{ _verify_counts.fail }} of {{ (_verify_counts.pass | int) + (_verify_counts.fail | int) }}
  evaluated controls returned an exception. Details are recorded in section 4.
</p>
{% else %}
<p class="statement">
  The deployed fabric conforms to the declared intent. All
  {{ _verify_counts.pass }} evaluated controls passed, with no exceptions.
</p>
{% endif %}

<table>
  <caption>Table 1 — Summary of results</caption>
  <thead><tr><th>Outcome</th><th>Controls</th><th>Basis</th></tr></thead>
  <tbody>
    <tr><td>Pass</td><td>{{ _verify_counts.pass }}</td>
        <td class="muted">Observed value equals the declared value</td></tr>
    <tr><td>Exception</td><td>{{ _verify_counts.fail }}</td>
        <td class="muted">Observed value differs from the declared value</td></tr>
    <tr><td>Not verified</td><td>{{ _verify_counts.not_verified }}</td>
        <td class="muted">No evidence returned; no opinion expressed</td></tr>
    <tr><td>Not applicable</td><td>{{ _verify_counts.skipped }}</td>
        <td class="muted">Control does not apply to the device's role</td></tr>
  </tbody>
</table>

<h2 id="s2">2. Scope</h2>
<p>
  The devices below were assessed. Each is managed by Catalyst Center and was
  addressed through Command Runner using its inventory management address.
</p>
<table>
  <caption>Table 2 — Devices in scope</caption>
  <thead><tr><th>Management address</th><th>Catalyst Center hostname</th><th>Family</th><th>Role</th></tr></thead>
  <tbody>
  {% for d in _verify_devices %}
    <tr><td class="mono">{{ d.ip }}</td><td class="mono">{{ d.hostname }}</td>
        <td>{{ d.family }}</td><td>{{ d.role }}</td></tr>
  {% endfor %}
  </tbody>
</table>

<h2 id="s3">3. Basis of verification</h2>
<p>
  Declared intent was taken from the template definitions held in Catalyst Center,
  not from the source repository. Stage 06 seeds Catalyst Center from either a
  Git repository or a local folder; this assessment therefore reflects the
  definitions that were actually deployed. The revision of each definition used
  is recorded below.
</p>
<table>
  <caption>Table 3 — Template definitions relied upon</caption>
  <thead><tr><th>Definition</th><th>Project</th><th>Identifier</th><th>Last updated</th></tr></thead>
  <tbody>
  {% for t in _defn_templates %}
    <tr><td class="mono">{{ t.name }}</td><td>{{ t.project }}</td>
        <td class="mono small">{{ t.id }}</td>
        <td>{{ ('%Y-%m-%d %H:%M' | strftime((t.last_update | int) / 1000)) if (t.last_update | int) > 0 else 'not recorded' }}</td></tr>
  {% endfor %}
  </tbody>
</table>
<p class="small muted">
  Additionally from <code>settings.json</code>: wireless SSID
  <code>{{ _intent_settings.ssid }}</code>; wireless VLANs
  {{ _intent_settings.wireless_vlans | join(', ') }};
  {{ _intent_settings.access_points | length }} declared access point(s).
</p>

<h2 id="s4">4. Findings</h2>
<p>
  Each row states one declared value and the corresponding value observed on the
  device. Comparison is exact equality against a field parsed from the command
  output. Rows marked <strong>Exception</strong> are shaded.
</p>

{% set seen = namespace(ids=[]) %}
{% for dev in _verify_devices %}
{% set devidx = loop.index %}
{% set rows = _verify_results | selectattr('device', 'equalto', dev.hostname) | list %}
{% set devfail = rows | selectattr('status', 'equalto', 'FAIL') | list | length %}
<h3 id="dev-{{ devidx }}">
  4.{{ devidx }} {{ dev.hostname }}
  <span class="backlink">{{ dev.ip }} · {{ devfail }} exception(s) · <a href="#top">top</a></span>
</h3>
<table>
  <caption>Table {{ 3 + devidx }} — Controls evaluated on {{ dev.hostname }}</caption>
  <thead><tr><th style="width:22%">Control</th><th>Result</th>
             <th style="width:32%">Declared</th><th style="width:32%">Observed</th></tr></thead>
  <tbody>
  {% for r in rows %}
    {% set anchor = r.id not in seen.ids %}
    {% if anchor %}{% set _ = seen.ids.append(r.id) %}{% endif %}
    {% if r.details %}
      {% for d in r.details %}
      <tr{% if not d.found %} class="exception"{% endif %}>
        <td>{% if loop.first %}<span {% if anchor %}id="check-{{ r.id }}"{% endif %}>{{ r.title }}</span>{% endif %}</td>
        <td class="status">{{ 'Exception' if not d.found else 'Pass' }}</td>
        <td class="mono">{{ d.pattern }}</td>
        <td class="mono">{{ d.observed }}</td>
      </tr>
      {% endfor %}
    {% else %}
      <tr>
        <td><span {% if anchor %}id="check-{{ r.id }}"{% endif %}>{{ r.title }}</span></td>
        <td class="status">{{ 'Not applicable' if r.status == 'SKIPPED' else 'Not verified' }}</td>
        <td colspan="2" class="muted">
          {% if r.status == 'SKIPPED' %}Control does not apply to this device's role.
          {% else %}No output returned for <code>{{ r.command }}</code>.{% endif %}
        </td>
      </tr>
    {% endif %}
  {% endfor %}
  </tbody>
</table>
{% endfor %}

<h2 id="s5">5. Control index</h2>
<p>Each control, the command providing its evidence, and its outcome across the devices in scope.</p>
<table>
  <caption>Table {{ 4 + (_verify_devices | length) }} — Controls</caption>
  <thead><tr><th style="width:34%">Control</th><th>Evidence</th><th>Pass</th><th>Exception</th><th>Other</th></tr></thead>
  <tbody>
  {% for cid in _verify_results | map(attribute='id') | unique | list %}
    {% set rows = _verify_results | selectattr('id', 'equalto', cid) | list %}
    {% set p = rows | selectattr('status', 'equalto', 'PASS') | list | length %}
    {% set f = rows | selectattr('status', 'equalto', 'FAIL') | list | length %}
    <tr>
      <td><a href="#check-{{ cid }}">{{ (rows | first).title }}</a></td>
      <td class="mono">{{ (rows | first).command }}</td>
      <td>{{ p }}</td><td>{{ f }}</td><td>{{ rows | length - p - f }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{% if _verify_blacklisted | length > 0 %}
<h2 id="s6">6. Limitations of scope</h2>
<p>
  Catalyst Center declined to execute the commands below, so the controls
  relying on them could not be evaluated. No opinion is expressed on those
  controls; they are excluded from the counts in section 1.
</p>
<table>
  <caption>Table {{ 5 + (_verify_devices | length) }} — Commands not executed</caption>
  <thead><tr><th>Device</th><th>Command</th><th>Disposition</th></tr></thead>
  <tbody>
  {% for b in _verify_blacklisted %}
    <tr><td class="mono">{{ b.device }}</td><td class="mono">{{ b.command }}</td><td>{{ b.bucket }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

<footer>
  This assessment is read-only: it issues Catalyst Center GET requests and
  Command Runner read requests only, and makes no change to any device.
  {{ _verify_results | length }} control(s) evaluated across
  {{ _verify_devices | length }} device(s).
</footer>

</div>
</body>
</html>
